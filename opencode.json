{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "CONTEXT.md"],
  "permission": {
    "edit": {
      "*": "ask",
      "src/**": "allow",
      "departamentos-y-ciudades-de-colombia-para-woocommerce/**": "allow",
      "libs/**": "deny"
    },
    "bash": {
      "*": "allow",
      "git add*": "deny",
      "git commit*": "deny",
      "git push*": "deny",
      "git tag*": "deny",
      "git merge*": "deny",
      "git rebase*": "deny",
      "git reset*": "deny",
      "git stash*": "deny",
      "git clean*": "deny",
      "composer require*": "deny",
      "composer install*": "deny",
      "composer update*": "deny",
      "composer remove*": "deny",
      "npm install*": "deny",
      "npm update*": "deny",
      "npm run install*": "deny",
      "npm run update*": "deny",
      "yarn add*": "deny",
      "yarn install*": "deny",
      "pnpm add*": "deny",
      "pnpm install*": "deny",
      "rm -r* libs*": "deny",
      "rm -r* ./libs*": "deny",
      "rm -r* libs/**": "deny"
    }
  }
}
